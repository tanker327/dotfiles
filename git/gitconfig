#####################################################
# Core Configuration
#####################################################

[core]
	excludesfile = ~/.gitignore_global
	editor = vim
	pager = diff-so-fancy | less --tabs=4 -RFX

#####################################################
# User Configuration
#####################################################

[user]
	name = Eric
	email = tanker327@gmail.com

#####################################################
# Push/Pull Configuration
#####################################################

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = false

[rebase]
	autoStash = true
	updateRefs = true

[init]
	defaultBranch = main
#####################################################
# Color Configuration
#####################################################

[color]
	ui = true

#####################################################
# Git Aliases
#####################################################

[alias]
	# Basic shortcuts
	st = status
	co = checkout
	cm = commit
	br = branch
	a = add
	ad = add
	cp = cherry-pick

	# Undo operations
	una = reset HEAD
	unadd = reset HEAD
	uncm = reset --soft HEAD^
	uncommit = reset --soft HEAD^

	# Logs and history
	last = log -1
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short

	# Push operations
	pushf = push -f origin
	fpush = push -f origin

#####################################################
# Git LFS Configuration
#####################################################

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process

#####################################################
# Diff & Merge Configuration
#####################################################

[interactive]
	diffFilter = diff-so-fancy --patch

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

#####################################################
# Fetch / Branch / Help / Transfer
#####################################################

[fetch]
	prune = true
	pruneTags = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[help]
	autocorrect = prompt

[transfer]
	fsckObjects = true

#####################################################
# diff-so-fancy Color Configuration
#####################################################

[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22

[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
# Credential helpers work on macOS and Linux, and silently skip when the tool isn't installed.
# gh: look in PATH first, then common install locations (GUI apps may not have Homebrew in PATH):
#   /opt/homebrew/bin (Apple Silicon), /usr/local/bin (Intel Mac), /usr/bin (Linux apt)
[credential "https://github.com"]
	helper =
	helper = "!f() { for g in \"$(command -v gh)\" /opt/homebrew/bin/gh /usr/local/bin/gh /usr/bin/gh; do if [ -x \"$g\" ]; then exec \"$g\" auth git-credential \"$@\"; fi; done; }; f"
[credential "https://gist.github.com"]
	helper =
	helper = "!f() { for g in \"$(command -v gh)\" /opt/homebrew/bin/gh /usr/local/bin/gh /usr/bin/gh; do if [ -x \"$g\" ]; then exec \"$g\" auth git-credential \"$@\"; fi; done; }; f"
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
# Cursor origin: only used if ~/.local/bin/origin exists on this machine
[credential "https://origin.cursor.com/git"]
	helper =
	helper = "!f() { if [ -x \"$HOME/.local/bin/origin\" ]; then exec \"$HOME/.local/bin/origin\" credential-helper \"$@\"; fi; }; f"
[credential "https://origin.cursor.com"]
	helper =
	helper = "!f() { if [ -x \"$HOME/.local/bin/origin\" ]; then exec \"$HOME/.local/bin/origin\" credential-helper \"$@\"; fi; }; f"
